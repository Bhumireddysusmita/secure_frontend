# Public Cloudflare Turnstile site key (safe to expose to the browser).
# Cloudflare official TEST site keys for local / CI use:
#   1x00000000000000000000AA  -> always passes (visible)
#   2x00000000000000000000AB  -> always blocks (visible)
#   3x00000000000000000000FF  -> forces an interactive challenge
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Where the Vite dev/preview server proxies /api requests.
API_PROXY_TARGET=http://127.0.0.1:8001
